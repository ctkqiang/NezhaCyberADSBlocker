<?xml version="1.0" encoding="utf-8"?>
<!--
  「已被拦截的通知」替代通知的内容视图。

  它与另外两条通知（nezha_notification_ad_block.xml / nezha_notification_vpn.xml）用同一套
  视觉语言：品牌色左条 + 应用图标 + 文本。三条通知出自同一个应用，就必须长得像同一个应用发的。

  与广告拦截通知的展开态结构相同，只是这里没有折叠/展开之分：原通知的正文本身就是这条通知要
  传达的全部内容，藏起来再让用户下拉展开，等于把唯一的信息加了一道门。

  应用图标用 logo 而不是状态栏那个盾牌：setSmallIcon 的图必须是单色剪影（系统只取 alpha 通道），
  彩色图会被画成一团白块，因此彩色位图只能出现在内容区。详见广告拦截通知布局的说明。

  文字颜色不写死、视图种类受限的原因见广告拦截通知的布局说明，三者受同一条平台约束。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="4dp"
  android:paddingTop="10dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/notification_accent_bar"
      android:layout_width="4dp"
      android:layout_height="32dp"
      android:background="@drawable/nezha_notification_accent_bar"
      android:contentDescription="@null" />

    <ImageView
      android:id="@+id/notification_icon"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_marginStart="12dp"
      android:contentDescription="@null"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_launcher_logo" />

    <TextView
      android:id="@+id/notification_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/notification_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:ellipsize="end"
    android:lineSpacingExtra="2dp"
    android:maxLines="8"
    android:textSize="13sp" />
</LinearLayout>
