<?xml version="1.0" encoding="utf-8"?>
<!--
  拦截通知的**折叠态**内容视图。展开态是 nezha_notification_ad_block_expanded.xml。

  两份布局必须分开，而且必须真的不一样。此前两者共用同一份 RemoteViews，导致下拉展开后画面
  没有任何变化——展开这个手势是用户在通知上最熟悉的交互，做空了整条通知就显得是死的。

  分工：折叠态只回答「拦了什么、是谁在请求」两个问题，因此是一行域名加一行来源应用；明细留给
  展开态，让展开这个动作有实际回报。

  **不写死文字颜色**：Android 12 起系统会按主题强制决定自定义通知里的文字颜色以保证对比度，
  写死的颜色会被忽略，反而在不同版本上表现不一致。品牌观感交给左侧色条与应用图标，文本交给
  系统——这是唯一在各版本与各厂商 ROM 上都稳定的组合。

  图标用应用自己的 logo，不用状态栏那个盾牌。原因是两者的平台要求不同：`setSmallIcon` 的图
  必须是单色剪影（系统只取 alpha 通道，彩色图会画成一团白块），所以状态栏只能留盾牌；而内容区
  是彩色位图能正常显示的地方，放 logo 才能让用户一眼认出这条通知来自哪个应用。

  尺寸取 42dp：logo 是细节丰富的插画（哪吒 + 混天绫 + 文字），缩到 36dp 以下关键细节
  就糊成一团认不出了。它比左边的色条高，因此色条也跟着放长，两者等高才不会看成两个错位的元素。

  视图种类受 RemoteViews 限制：这里只能出现 RemoteViews 支持的控件，用了别的会在真机上静默
  失效——通知变成空白，而不是报错。因此布局刻意保持成一个横向容器 + 一列文本。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="4dp"
  android:paddingTop="10dp"
  android:paddingBottom="10dp">

  <ImageView
    android:id="@+id/notification_accent_bar"
    android:layout_width="4dp"
    android:layout_height="44dp"
    android:background="@drawable/nezha_notification_accent_bar"
    android:contentDescription="@null" />

  <ImageView
    android:id="@+id/notification_icon"
    android:layout_width="42dp"
    android:layout_height="42dp"
    android:layout_marginStart="12dp"
    android:contentDescription="@null"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_launcher_logo" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/notification_headline"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/notification_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
